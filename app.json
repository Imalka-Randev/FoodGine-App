        "backgroundColor": "#fca311",
        "foregroundImage": "./assets/genie-icon.jpg"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"     
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
