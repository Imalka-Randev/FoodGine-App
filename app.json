    "slug": "food-genie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/genie-icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/genie-splash.jpg",
      "resizeMode": "contain",
