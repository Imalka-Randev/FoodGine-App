{
  "expo": {
    "name": "Food Genie",
    "slug": "food-genie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foodby-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/foodby-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fca311",
        "foregroundImage": "./assets/foodby-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
